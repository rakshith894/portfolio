.nocturne-scene {
  outline: none;
}
.entrance-scene {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background: #070b10;
  color: #ebe7dd;
  isolation: isolate;
}
.entrance-viewport {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(100vw, calc(100dvh * 1672 / 941));
  aspect-ratio: 1672 / 941;
  transform: translate(-50%, -50%);
  overflow: hidden;
}
.entrance-artwork {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: 0 0;
  transition: transform 1600ms cubic-bezier(0.22, 0.61, 0.36, 1);
}
.entrance-at-gate {
  transform: translate(-65%, -40.75%) scale(1.65);
}
.entrance-image {
  width: 100%;
  height: 100%;
  display: block;
  user-select: none;
}
.entrance-fire {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.entrance-hotspots {
  position: absolute;
  inset: 0;
}
.entrance-hotspot[data-slot='button'] {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #f5dfb9;
}
.entrance-hotspot[data-slot='button']:hover {
  background: #0a10165c;
}
.entrance-marker {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #f0d09c;
  border: 2px solid #f9e7c6;
  box-shadow: 0 0 0 6px #eacb9322,
    0 0 22px #d6a970aa;
}
.entrance-hotspot-label {
  pointer-events: none;
  position: absolute;
  bottom: calc(100% + 3px);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 13px;
  border: 1px solid #d3bd923d;
  border-radius: 3px;
  background: #0c1219ed;
  font: 11px Arial,
    sans-serif;
  opacity: 0;
  transition: opacity 180ms;
}
.entrance-hotspot:hover .entrance-hotspot-label,
.entrance-hotspot:focus-visible .entrance-hotspot-label {
  opacity: 1;
}
.entrance-header {
  position: absolute;
  inset: 0 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: max(26px, env(safe-area-inset-top)) 32px 0;
  pointer-events: none;
}
.entrance-brand {
  text-shadow: 0 2px 16px #000;
}
.entrance-brand h1 {
  margin: 0;
  font: 17px Georgia,
    serif;
  letter-spacing: 4px;
}
.entrance-brand > span {
  display: block;
  margin-top: 9px;
  font-size: 8px;
  letter-spacing: 2.5px;
  color: #c5cbd0;
}
.entrance-sound[data-slot='button'],
.entrance-clean-view[data-slot='button'],
.entrance-motion[data-slot='button'] {
  width: 42px;
  height: 42px;
  border: 1px solid #c1cbd32a;
  border-radius: 50%;
  background: #080e169e;
  color: #cbd0d4;
  pointer-events: auto;
  backdrop-filter: blur(8px);
}
.entrance-tools {
  display: flex;
  gap: 8px;
}
.entrance-clean-view[data-slot='button'] {
  position: absolute;
  right: 32px;
  bottom: max(28px, env(safe-area-inset-bottom));
}
.entrance-image-only .entrance-clean-view {
  opacity: 0.35;
}
.entrance-image-only .entrance-clean-view:hover,
.entrance-image-only .entrance-clean-view:focus-visible {
  opacity: 1;
}
.entrance-footer {
  position: absolute;
  left: 50%;
  bottom: max(28px, env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: max-content;
  max-width: calc(100% - 150px);
  text-align: center;
}
.entrance-footer > p {
  margin: 0 0 14px;
  font-size: 8px;
  letter-spacing: 2px;
  color: #d3d2c9;
  text-shadow: 0 1px 9px #000,
    0 2px 15px #000;
}
.entrance-footer nav {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px;
  background: #080e16bd;
  border: 1px solid #c1cbd326;
  border-radius: 4px;
  backdrop-filter: blur(10px);
}
.entrance-footer [data-slot='button'] {
  height: 42px;
  padding: 0 16px;
  border-radius: 2px;
  font-size: 11px;
  font-weight: 400;
  gap: 9px;
}
.entrance-footer .entrance-primary {
  color: #f2dbb3;
  background: #d4ac6720;
  border-color: #d4ac675c;
}
.entrance-transition {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: linear-gradient(#070b1088, #070b10cc),
    url('/graveyard.png') center / contain no-repeat #070b10;
  color: #ebe7dd;
}
.entrance-transition p {
  font: 24px Georgia,
    serif;
}
@media (max-width: 700px) {
  .entrance-header {
    padding: max(22px, env(safe-area-inset-top)) 18px 0;
  }
  .entrance-brand h1 {
    font-size: 15px;
  }
  .entrance-footer {
    bottom: max(30px, env(safe-area-inset-bottom));
    width: calc(100% - 32px);
    max-width: none;
  }
  .entrance-footer nav {
    gap: 0;
    justify-content: center;
  }
  .entrance-footer [data-slot='button'] {
    font-size: 10px;
    padding: 0 10px;
    flex: 1;
  }
  .entrance-footer > p {
    font-size: 7px;
    letter-spacing: 1.5px;
  }
  .entrance-footer [data-slot='button'] svg {
    width: 12px;
  }
  .entrance-clean-view[data-slot='button'] {
    right: 18px;
    bottom: auto;
    top: max(76px, calc(env(safe-area-inset-top) + 54px));
  }
}
@media (max-width: 380px) {
  .entrance-footer [data-slot='button'] {
    padding: 0 6px;
    gap: 5px;
    font-size: 9px;
  }
}
@media (max-height: 500px) and (orientation: landscape) {
  .entrance-header {
    padding: 12px 18px 0;
  }
  .entrance-footer {
    bottom: 10px;
  }
  .entrance-footer > p {
    display: none;
  }
  .entrance-footer [data-slot='button'] {
    height: 36px;
  }
  .entrance-clean-view[data-slot='button'] {
    top: auto;
    bottom: 14px;
    right: 18px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .entrance-artwork,
  .entrance-hotspot-label {
    transition: none;
  }
}
