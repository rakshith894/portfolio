.lift-transition {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: grid;
  place-items: center;
  pointer-events: all;
  background: #081015;
  animation: lift-fade 1.6s both;
}
.lift-transition > div {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 50%;
  background: linear-gradient(90deg, #101c23, #1e2c31);
  border: 1px solid #b6b8a52b;
}
.lift-transition > div:first-child {
  left: 0;
  animation: lift-left 1.6s both;
}
.lift-transition > div:nth-child(2) {
  right: 0;
  animation: lift-right 1.6s both;
}
.lift-transition > span {
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  font: 62px Georgia,
    serif;
  color: #dbd5bd;
}
.lift-transition small {
  font: 9px Arial,
    sans-serif;
  letter-spacing: 3px;
  color: #9dada9;
}
@keyframes lift-left {
  0% {
    transform: translateX(-100%);
  }
  22%,
  78% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}
@keyframes lift-right {
  0% {
    transform: translateX(100%);
  }
  22%,
  78% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(100%);
  }
}
@keyframes lift-fade {
  0%,
  100% {
    opacity: 0;
  }
  20%,
  80% {
    opacity: 1;
  }
}
