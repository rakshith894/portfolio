:root,
.dark {
  --background: #0b1012;
  --foreground: #eeeae0;
  --card: #141b1e;
  --popover: #121a1e;
  --primary: #e8e3d5;
  --primary-foreground: #151b1d;
  --secondary: #202a2e;
  --muted: #1a2429;
  --muted-foreground: #a4aeb0;
  --accent: #253237;
  --border: #ffffff24;
  --ring: #b8cfcd;
  --radius: 2px;
}
* {
  box-sizing: border-box;
}
html,
body {
  margin: 0;
  min-height: 100%;
  background: var(--background);
  color: var(--foreground);
  font-family: Arial, Helvetica, sans-serif;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
}
button:focus-visible,
a:focus-visible {
  outline: 2px solid #c3d4d3;
  outline-offset: 6px;
}
button:disabled {
  cursor: default;
}
a {
  color: inherit;
  text-decoration: none;
}
.landing {
  position: relative;
  isolation: isolate;
  min-height: 100svh;
  overflow: hidden;
}
.landscape {
  position: absolute;
  inset: 0 0 110px;
  background: url('/graveyard.webp') center 46%/cover no-repeat;
  z-index: -3;
  animation: landscape-in 2s ease-out both;
}
.atmosphere {
  position: absolute;
  inset: 0;
  z-index: -2;
  background: linear-gradient(
      90deg,
      rgba(5, 12, 17, 0.84) 0%,
      rgba(7, 14, 20, 0.58) 32%,
      rgba(8, 15, 20, 0.06) 72%
